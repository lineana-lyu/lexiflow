  "morphemes": [
    {
      "id": "bene",
      "display": "BENE",
      "type": "root",
      "language": "Latin",
      "meaningEn": "well; in a good way",
      "meaningZh": "好；良好；向好",
      "narrativeZh": "BENE 来自拉丁语 bene，核心是“好地、顺利地”。它常出现在与好的结果、善意或益处有关的词源关系中。看到 bene- 时，可以先抓住“好、向好”这个方向，再结合单词的其他部分理解完整词义。",
      "sourceIds": [
        "ls-bene"
      ]
    },
    {
      "id": "dict",
      "display": "DICT",
      "type": "root",
      "language": "Latin",
      "meaningEn": "say; speak; utter",
      "meaningZh": "说；表达",
      "narrativeZh": "DICT 与拉丁语中“说、表达”这一组词义有关。它进入不同单词后，常保留“说出、陈述、表达”的语义线索。遇到 dict 时，可以先问自己：这个词是不是在说“怎么说、向谁说、把什么说出来”。",
      "sourceIds": [
        "ls-dictio"
      ]
    },
    {
      "id": "tract",
      "display": "TRACT",
      "type": "root",
      "language": "Latin",
      "meaningEn": "draw; drag; pull",
      "meaningZh": "拉；拖；牵引",
      "narrativeZh": "TRACT 与拉丁语 trahere 的“拉、拖、牵引”有关。很多同根词虽然已经变成抽象含义，但仍能找到“把某物拉向、拉开、拉回”的动作感。记住这个动作，比单独背一个中文释义更容易迁移到新词。",
      "sourceIds": [
        "ls-traho"
      ]
    },
    {
      "id": "duc",
      "display": "DUC / DUCT",
      "type": "root",
      "language": "Latin",
      "meaningEn": "lead; conduct; bring",
      "meaningZh": "带领；引导；带来",
      "narrativeZh": "DUC / DUCT 来自拉丁语 ducere，核心动作是“带领、引导”。在不同前缀的作用下，它可以表示带进来、带出去、向前带或向回带。看到 duc/duct 时，可以先寻找“引导方向”的感觉。",
      "sourceIds": [
        "ls-duco"
      ]
    },
    {
      "id": "grav",
      "display": "GRAV",
      "type": "root",
      "language": "Latin",
      "meaningEn": "heavy; weighty; serious",
      "meaningZh": "重；有分量；严重",
      "narrativeZh": "GRAV 与拉丁语 gravis 的“重、沉重”有关。这个“重”后来既可以是物理重量，也可以延伸到“严肃、严重、有分量”。所以看到 grav-，可以先从“重量感”出发理解它的抽象义。",
      "sourceIds": [
        "ls-gravis"
      ]
    },
    {
      "id": "lev",
      "display": "LEV",
      "type": "root",
      "language": "Latin",
      "meaningEn": "light; raise; lighten",
      "meaningZh": "轻；举起；减轻",
      "narrativeZh": "LEV 与拉丁语 levis“轻”以及 levo“举起、使变轻”有关。它的核心联想不是某个固定中文词，而是“让重量变轻、把东西抬起来”。这个动作感能帮助理解表示减轻、升高的一组词。",
      "sourceIds": [
        "ls-levis",
        "ls-levo"
      ]
    }
  ],
